+
+    def _nfc_field(self, event: bytes):
+        """Card enters (01 01 uid) or leaves (02) the field. The app only hears it while its reader is on."""
+        if event[:1] == b"\x01":
+            self.card = event
+        elif self.card is None:
+            return
+        else:
+            self.card = None
+        if self.nfc_power == 2:
+            self.socket_helper.queue_packet(SephTag.NFC_EVENT, event)
+
+    def _nfc_reader_server(self, port: int):
+        """
+        One TCP client at a time. Frames both ways: 4-byte big-endian length, then 1 type byte + body.
+        client -> speculos: b"E" + NFC_EVENT payload (01 01 <uid> card detected, 02 card removed)
+                            b"R" + response to the last reader command (reaches the app as packet type 0x41)
+        speculos -> client: b"C" + command the app sent with io_nfc_reader_send
+        Disconnecting removes the card.
+        """
+        srv = socketlib.create_server(("0.0.0.0", port))  # noqa: S104 (inside the container)
+        self.logger.info(f"NFC reader port {port}")
+        while True:
+            conn, _ = srv.accept()
+            self.reader_client = conn
+            f = conn.makefile("rb")
+            try:
+                while len(hdr := f.read(4)) == 4:
+                    frame = f.read(int.from_bytes(hdr, "big"))
+                    kind, body = frame[:1], frame[1:]
+                    self.logger.info(f"nfc-reader > {frame.hex()}")
+                    if kind == b"E":
+                        self._nfc_field(body)
+                    elif kind == b"R" and self.nfc_power == 2:
+                        self.reader_nfc.send(body)
+                    else:
+                        self.logger.warning(f"nfc-reader: dropped {frame.hex()} (nfc_power={self.nfc_power})")
+            except OSError:
+                pass
+            finally:
+                self.reader_client = None
+                conn.close()
+                self._nfc_field(b"\x02")
+
